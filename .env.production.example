# ===========================================
# FlotteQ - Production Environment Variables
# ===========================================
# Copier ce fichier en .env.production et remplir les vraies valeurs.
# Ne jamais committer .env.production (déjà dans .gitignore).

# ===== Database =====
DB_HOST=postgres
DB_PORT=5432
DB_USER=flotteq_prod
DB_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
DB_NAME=flotteq_production

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ENABLED=true
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD

# ===== JWT (générer avec: openssl rand -base64 64) =====
JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_PARTNER_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PARTNER_TOKEN_EXPIRY=7d

# ===== Stripe (clés LIVE) =====
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY

# ===== URLs publiques (HTTPS, domaines flotteq.fr) =====
CORS_ORIGIN=https://app.flotteq.fr,https://partner.flotteq.fr,https://driver.flotteq.fr,https://admin.flotteq.fr,https://flotteq.fr
FRONTEND_CLIENT_URL=https://app.flotteq.fr
PARTNER_FRONTEND_URL=https://partner.flotteq.fr
DRIVER_FRONTEND_URL=https://driver.flotteq.fr
INTERNAL_FRONTEND_URL=https://admin.flotteq.fr
APP_URL=https://api.flotteq.fr

# ===== Build args Vite (utilisés à la build des frontends) =====
VITE_API_BASE=https://api.flotteq.fr
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY

# ===== Sécurité =====
BCRYPT_ROUNDS=12
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/*,application/pdf

# ===== SMTP (OVH par défaut) =====
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@flotteq.fr
SMTP_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
EMAIL_FROM=noreply@flotteq.fr

# ===== Let's Encrypt =====
LETSENCRYPT_EMAIL=wissemkarboub@gmail.com
